# Copy to .env (scripts/setup.sh does this and keeps it private).

# The address players use, without a trailing slash.
PUBLIC_URL=https://game.example.com

# Host port for the HTTPS listener.
HTTPS_PORT=8443

# Authentik OAuth2/OpenID provider. The issuer is the provider's "OpenID Configuration Issuer".
# Redirect URI to register: <PUBLIC_URL>/auth/callback
OIDC_ISSUER=https://auth.example.com/application/o/gridrescue/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Comma-separated Authentik groups allowed to edit the game. Empty disables the admin area.
ADMIN_GROUPS=

# Comma-separated IPs or CIDRs of your reverse proxy, so rate limits see real client addresses.
# Leave empty when nothing sits in front of the app.
TRUST_PROXY=

LOG_LEVEL=info
